# GENERAL
CLOUDGIT_USER=cloudgit_admin
CLOUDGIT_PASSWORD=1234567890
CLOUDGIT_EMAIL=example@gmail.com
DEBUG=true
SCHEME=http
# AUTH
AUTH_DB_NAME=auth
AUTH_HOST=0.0.0.0
AUTH_PORT=8000
AUTH_SECRET_KEY="django-insecure-mq!b&uyz9hj=tazg4yrse9e=%xnf3r&sh^5i0b03mf5$=k*xy8"
# REPO
REPO_DB_NAME=repo
REPO_HOST=0.0.0.0
REPO_PORT=8000
REPO_SECRET_KEY="django-insecure-mq!b&uyz9hj=tazg4yrse9e=%xnf3r&sh^5i0b03mf5$=k*xy8"
# POSTGRES
PGDATA=/var/lib/postgresql/data
POSTGRES_DB=postgres
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_PASSWORD=1234567890
POSTGRES_USER=postgres
# PGADMIN
PGADMIN_DEFAULT_EMAIL=example@gmail.com
PGADMIN_DEFAULT_PASSWORD=1234567890
# SSHPROXY
CLIENT_KEYS_DIR=/home/${CLOUDGIT_USER}/.ssh/client_keys
HOST_KEYS_DIR=/home/${CLOUDGIT_USER}/.ssh/sshproxy_host_keys
SSHPROXY_EXT_HOST=127.0.0.1
SSHPROXY_EXT_PORT=33
SSHPROXY_HOST=0.0.0.0
SSHPROXY_PORT=22
# FRONTEND
FRONTEND_PORT=3000
# RABBITMQ
RABBITMQ_DEFAULT_PASS=1234567890
RABBITMQ_DEFAULT_USER=cloudgit_admin
RABBITMQ_NODE_PORT=5672
# STORAGE-1
STORAGE_1_NAME=cloudgit_storage_1
STORAGE_1_HOST=storage_1
STORAGE_1_PORT=22
STORAGE_1_PATH=/.storage/data
# STORAGE-2
STORAGE_2_NAME=cloudgit_storage_2
STORAGE_2_HOST=storage_2
STORAGE_2_PORT=22
STORAGE_2_PATH=/.storage/data
# NGINX
NGINX_EXT_HOST=127.0.0.1
NGINX_HTTP_EXT_PORT=81
NGINX_SSH_EXT_PORT=23
NGINX_HTTP_PORT=80
NGINX_SSH_PORT=22
